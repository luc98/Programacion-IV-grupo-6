# Variables del sistema. Copiar a .env (no se commitea) y completar los valores vacíos.

# Azure Service Bus. Cadena del topic grupo6-booking-topic
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_TOPIC=grupo6-booking-topic
AZURE_SERVICE_BUS_SUBSCRIPTION=booking

# MongoDB. Vacía usa el contenedor local con replica set
MONGODB_CONNECTION_STRING=

# Keycloak
KEYCLOAK_REALM=reservas-realm
GOOGLE_CLIENT_SECRET=
AVAILABILITY_CLIENT_SECRET=**********
BOOKING_CLIENT_SECRET=**********

# Payment
PAYMENT_DB_PASSWORD=payment-dev
PAYMENT_VALIDATE_AUDIENCE=true
PAYMENT_RETARDO_MS=0
PAYMENT_LIMITE_CENTAVOS=2000000
