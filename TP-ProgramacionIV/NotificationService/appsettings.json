{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Servicio": "NotificationService"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{@t:HH:mm:ss} {@l:u3} [{Servicio}] [TraceId={TraceId}] {@m}\n{@x}"
          }
        }
      }
    ]
  },
  "Authentication": {
    "Enabled": false,
    "Authority": "http://localhost:8080/realms/reservas-realm",
    "ValidIssuer": "",
    "Audience": "notifications-api",
    "ValidateAudience": false,
    "RequireHttpsMetadata": false,
    "AllowedClients": [ "booking-api" ]
  },
  "Notifications": {
    "Mapping": {
      "RecipientField": "UsuarioId",
      "DeduplicationFields": [ "ReservaId" ]
    },
    "Templates": {
      "ReservaCreada": "Tu reserva {ReservaId} quedó retenida hasta {FechaVencimientoUtc}. Pagá antes de que venza para confirmarla.",
      "ReservaConfirmada": "Tu reserva {ReservaId} fue confirmada. ¡Gracias por tu compra!"
    }
  }
}
