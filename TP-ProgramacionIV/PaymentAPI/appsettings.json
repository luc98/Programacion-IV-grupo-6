{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.DataProtection": "Error",
        "Grpc": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Servicio": "PaymentAPI"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
            "template": "{@t:HH:mm:ss} {@l:u3} [{Servicio}] [TraceId={TraceId}] {@m}\n{@x}"
          }
        }
      }
    ]
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "PaymentDb": ""
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/reservas-realm",
    "ValidIssuer": "http://localhost:8080/realms/reservas-realm",
    "Audience": "payment-api",
    "ValidateAudience": true,
    "AllowedClients": [ "booking-api" ],
    "RequireHttpsMetadata": true
  },
  "BancoSimulado": {
    "LimitePorCobroCentavos": 5000000,
    "UsuariosSinFondos": [ "usuario-sin-fondos" ],
    "RetardoMs": 0
  },
  "Database": {
    "MigrarAlIniciar": true
  },
  "AllowedHosts": "*"
}
