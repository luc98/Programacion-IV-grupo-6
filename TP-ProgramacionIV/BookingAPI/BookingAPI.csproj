<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>9cd132a1-3bf5-44c3-b133-85c639d2439b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Polly" Version="8.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="BLL\Protos\payment.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="BLL\DTOs\" />
    <Folder Include="BLL\Interfaces\" />
    <Folder Include="BLL\Gateways\" />
    <Folder Include="BLL\Jobs\" />
    <Folder Include="BLL\Protos\" />
    <Folder Include="BLL\Services\" />
    <Folder Include="DAL\Context\" />
    <Folder Include="DAL\Repositories\" />
    <Folder Include="Presentation\Controllers\" />
    <Folder Include="Presentation\Listeners\" />
  </ItemGroup>

</Project>
