{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BookingDb": "Host=localhost;Port=5432;Database=BookingDb;Username=postgres;Password=postgrespassword"
  },
  "Authentication": {
    "Authority": "http://localhost:8080/realms/reservas-realm",
    "Audience": "booking-api",
    "ClientId": "booking-api",
    "ClientSecret": "INGRESAR_SECRET",
    "TokenUrl": "http://localhost:8080/realms/reservas-realm/protocol/openid-connect/token",
    "RequireHttpsMetadata": false
  },
  "GrpcSettings": {
    "PaymentServiceUrl": "http://localhost:5260"
  },
  "ResilienciaPago": {
    "TimeoutTotalSegundos": 10,
    "TimeoutPorIntentoSegundos": 2,
    "Reintentos": 2,
    "DemoraInicialMs": 500,
    "DemoraMaximaMs": 2000,
    "ProporcionDeFallas": 0.5,
    "MinimoDeLlamadas": 3,
    "VentanaSegundos": 30,
    "CorteSegundos": 15
  },
  "AzureServiceBus": {
    "ConnectionString": "INGRESAR_AZURE_SERVICE_BUS_CONNECTION_STRING",
    "SolicitudesTopic": "solicitudes-reserva",
    "SolicitudesSubscription": "booking-sub",
    "SolicitudesQueue": "solicitudes-reserva",
    "NotificacionesTopic": "notificaciones-reserva"
  },
  "ExpirationWorker": {
    "IntervalSeconds": 10
  },
  "AllowedHosts": "*"
}
