<mxfile host="app.diagrams.net"><diagram id="notificaciones" name="Notification Service"><mxGraphModel dx="1520" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1070" background="#0f0f0f" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Notification Service (Dupla 4) - .NET 10 - Puerto 5050 (HTTP)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#8a8a8a;fontColor=#d9d9d9;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="900" height="840" as="geometry"/></mxCell><mxCell id="c4" value="Capa de Presentación (Presentation Layer)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#241d2d;strokeColor=#9673a6;fontColor=#d9d9d9;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="840" height="190" as="geometry"/></mxCell><mxCell id="c5" value="Capa de Lógica de Negocio (Núcleo)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#2b2210;strokeColor=#d79b00;fontColor=#d9d9d9;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="840" height="300" as="geometry"/></mxCell><mxCell id="c6" value="Capa de Salida (Adaptadores)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#17261a;strokeColor=#82b366;fontColor=#d9d9d9;fontStyle=1;fontSize=13;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="840" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Booking REST API (Dupla 2)&lt;/b&gt;&lt;br&gt;HttpNotificationPublisher&lt;br&gt;: IEventPublisher&lt;br&gt;Timeout de 2 s: no frena&lt;br&gt;la reserva si falla" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#3b2a0e;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="170" width="250" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;NotificationEndpoint&lt;/b&gt;&lt;br&gt;POST /api/notifications&lt;br&gt;• Lee x-trace-id y x-event-type&lt;br&gt;• Responde 202, 400 o 503" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#9673a6;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="250" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;HttpEventMapper&lt;/b&gt;&lt;br&gt;• Tipo: header x-event-type&lt;br&gt;• Si falta, el campo tipoEvento&lt;br&gt;• Arma el IncomingEvent" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#9673a6;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="170" width="240" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Kestrel&lt;/b&gt;&lt;br&gt;• Puerto 5050&lt;br&gt;• Cuerpo máximo: 64 KB&lt;br&gt;• 413 si lo supera&lt;br&gt;• 405 si no es POST" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#9673a6;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="190" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;EventProcessor&lt;/b&gt;&lt;br&gt;(IEventProcessor)&lt;br&gt;• Contexto de log con TraceId&lt;br&gt;• Inicio y Fin de auditoría" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="230" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;JsonEventMapper&lt;/b&gt;&lt;br&gt;(IEventMapper)&lt;br&gt;• Capa anticorrupción&lt;br&gt;• Destinatario y clave por config" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="400" width="230" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;NotificationHandler&lt;/b&gt;&lt;br&gt;• Orquesta el aviso&lt;br&gt;• Resultado: Completado,&lt;br&gt;  Rechazado o Reintentar" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="220" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;IDeduplicationStore&lt;/b&gt;&lt;br&gt;• En memoria, TryBegin atómico&lt;br&gt;• Clave: tipo + ReservaId" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="380" y="550" width="230" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;TemplateRenderer&lt;/b&gt;&lt;br&gt;• Plantilla por tipo de evento&lt;br&gt;• Sin plantilla: Rechazado" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#d79b00;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="550" width="230" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Correo o push (a futuro)&lt;/b&gt;&lt;br&gt;Otra implementación de&lt;br&gt;INotificationSender" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#82b366;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="230" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;ConsoleNotificationSender&lt;/b&gt;&lt;br&gt;• Escribe el aviso en el log" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#82b366;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="740" width="210" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;INotificationSender&lt;/b&gt;&lt;br&gt;SendAsync(destinatario, texto)&lt;br&gt;• Puerto de salida" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#82b366;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="740" width="220" height="100" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Transversal&lt;/b&gt;&lt;br&gt;Serilog + AuditLogExtensions&lt;br&gt;• TraceId en cada registro&lt;br&gt;• Servicio, Etapa, Operacion,&lt;br&gt;  Resultado y DuracionMs&lt;br&gt;&lt;br&gt;appsettings.json&lt;br&gt;• Plantillas, mapeo y Serilog" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#12233a;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="270" height="230" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Log del servicio (Serilog)&lt;/b&gt;&lt;br&gt;AVISO para &amp;lt;usuario&amp;gt;: &amp;lt;texto&amp;gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#3a1c1c;strokeColor=#b85450;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="660" y="960" width="250" height="70" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Decisiones de diseño&lt;/b&gt;&lt;br&gt;• Sin base de datos&lt;br&gt;• Sin broker: Booking lo llama&lt;br&gt;  directo, como recomendó&lt;br&gt;  el profesor&lt;br&gt;• Sin Keycloak: autenticación&lt;br&gt;  pendiente de acordar (3.e)&lt;br&gt;• Avisar no frena la reserva" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#bdbdbd;fontColor=#ffffff;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1260" y="170" width="240" height="2